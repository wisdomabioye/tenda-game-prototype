{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tenda prototype city place authoring file",
  "type": "object",
  "required": [
    "version",
    "cityId",
    "authoredPlaces"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cityId": {
      "type": "string"
    },
    "sample": {
      "const": true
    },
    "authoredPlaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "latitude",
          "longitude",
          "width",
          "depth",
          "rotation",
          "floors",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "type": {
            "enum": [
              "restaurant",
              "mall",
              "office",
              "shop",
              "landmark"
            ]
          },
          "latitude": {
            "type": "number",
            "minimum": -85,
            "maximum": 85
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "width": {
            "type": "number",
            "minimum": 4,
            "maximum": 12
          },
          "depth": {
            "type": "number",
            "minimum": 4,
            "maximum": 12
          },
          "rotation": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "floors": {
            "type": "integer",
            "minimum": 2,
            "maximum": 8
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    }
  },
  "description": "Runtime parser also validates city match, duplicate IDs, active patch bounds, road/building overlap and a connected entrance. Not partner verification."
}
